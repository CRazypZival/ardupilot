# hw definition file for processing by chibios_hwdef.py
# for STM32H743 LQFP100 ArduSub hardware

# MCU class and specific type - 使用STM32H743 LQFP100
MCU STM32H7xx STM32H743xx

# crystal frequency - 24MHz晶振
OSCILLATOR_HZ 25000000

# board ID for firmware load
APJ_BOARD_ID 200

# flash size - 2MB
FLASH_SIZE_KB 2048

# flash reserve for bootloader
FLASH_RESERVE_START_KB 384


define HAL_STORAGE_SIZE 32768

# 优化设置
env OPTIMIZE -O2

# 默认GPIO设置为低电平避免ESD问题
DEFAULTGPIO OUTPUT LOW PULLDOWN

# LED指示灯配置
# 活动状态LED
PE2 LED_ACTIVITY OUTPUT OPENDRAIN HIGH
define HAL_LED_ON 0

# 通信状态LED
PE3 LED_COMM_STATUS OUTPUT OPENDRAIN HIGH
define HAL_GPIO_A_LED_PIN 90

# 传感器状态LED
PE4 LED_SENSOR_STATUS OUTPUT OPENDRAIN HIGH
define HAL_GPIO_B_LED_PIN 91

# 16路PWM输出 + 1路恒温控制 + 3路舵机

# TIM2 - 4路PWM 
PA0 TIM2_CH1 TIM2 PWM(1) GPIO(50)
PA1 TIM2_CH2 TIM2 PWM(2) GPIO(51)
PA2 TIM2_CH3 TIM2 PWM(3) GPIO(52)
PA3 TIM2_CH4 TIM2 PWM(4) GPIO(53)

# TIM3 - 4路PWM 
PA6 TIM3_CH1 TIM3 PWM(5) GPIO(54)
PA7 TIM3_CH2 TIM3 PWM(6) GPIO(55)
PB0 TIM3_CH3 TIM3 PWM(7) GPIO(56)
PB1 TIM3_CH4 TIM3 PWM(8) GPIO(57)

# TIM4 - 4路PWM 
PB6 TIM4_CH1 TIM4 PWM(9) GPIO(58)
PB7 TIM4_CH2 TIM4 PWM(10) GPIO(59)
PD14 TIM4_CH3 TIM4 PWM(11) GPIO(60)
PD15 TIM4_CH4 TIM4 PWM(12) GPIO(61)

# TIM8 - 4路PWM 
PC6 TIM8_CH1 TIM8 PWM(13) GPIO(62)
PC7 TIM8_CH2 TIM8 PWM(14) GPIO(63)
PC8 TIM8_CH3 TIM8 PWM(15) GPIO(64)
PC9 TIM8_CH4 TIM8 PWM(16) GPIO(65)

# TIM1 - 1路恒温控制 + 3路舵机
PE9 TIM1_CH1 TIM1 PWM(17) GPIO(66) IMU_HEATER
PE11 TIM1_CH2 TIM1 PWM(18) GPIO(67) SERVO1
PE13 TIM1_CH3 TIM1 PWM(19) GPIO(68) SERVO2
PE14 TIM1_CH4 TIM1 PWM(20) GPIO(69) SERVO3

# 3组I2C接口
# I2C1
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1
# I2C2
PB10 I2C2_SCL I2C2
PB11 I2C2_SDA I2C2
# ICP20100气压计
BARO ICP201XX I2C:1:0x63
# BMM150磁力计
COMPASS BMM150 I2C:1:0x10 false ROTATION_NONE
PE15  MAG_DRDY INPUT

# I2C4
PD12 I2C4_SCL I2C4
PD13 I2C4_SDA I2C4

# I2C总线顺序
I2C_ORDER I2C1 I2C2 I2C4


# 串口顺序定义 - 只使用必要的串口
SERIAL_ORDER OTG1 USART1 USART2 USART3 UART4
# USB接口
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1
PA9 VBUS INPUT OPENDRAIN
# SWD调试接口
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD
# USART1
PB14 USART1_TX USART1
PB15 USART1_RX USART1
# USART2
PD5 USART2_TX USART2
PD6 USART2_RX USART2
# USART3
PC10 USART3_TX USART3
PC11 USART3_RX USART3
# USART4
PD1 UART4_TX UART4
PD0 UART4_RX UART4

# 启用IMU加热器
define HAL_HAVE_IMU_HEATER 1
define HAL_IMU_TEMP_DEFAULT 45
define HAL_IMUHEAT_P_DEFAULT 50
define HAL_IMUHEAT_I_DEFAULT 0.07
define HAL_IMU_TEMP_MARGIN_LOW_DEFAULT 5

# SPI存储 - W25Q128 Flash
PA4 W25Q128_CS CS
PA5 SPI1_SCK SPI1
PB4 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1

# SPI传感器 - BMI088陀螺仪
PE12 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4
PC0 BMI088_A_CS CS
PC1 BMI088_G_CS CS
PC2 BMI088_A_DRDY INPUT
PC3 BMI088_G_DRDY INPUT
PC13 BMI088_A_INT INPUT
PC14 BMI088_G_INT INPUT

# BEC控制引脚
PD3 BEC_ENABLE OUTPUT HIGH
PD4 BEC_FAULT_FLG INPUT PULLUP

# ADC引脚 - 电压和电流
PC5 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PC4 BATT_CURRENT_SENS ADC1 SCALE(1)
# 电池引脚定义
define HAL_BATT_VOLT_PIN 5
define HAL_BATT_CURR_PIN 4
define HAL_BATT_VOLT_SCALE 10.1
define HAL_BATT_CURR_SCALE 17.0

# DMA优先级设置
DMA_PRIORITY SPI1* SPI2* USART* UART* ADC* TIM*
